#!/usr/bin/env python3
"""Trace the Factorio theme's OMARCHY rail wordmark as ttfx protocol frames."""

import argparse
import os
import struct
import sys

# Adapted from omarchy-factorio-theme/screensaver/omarchy-screensaver.
GLYPHS = {
    "O": (".###.", "#...#", "#...#", "#...#", "#...#", "#...#", ".###."),
    "M": ("#...#", "##.##", "#.#.#", "#...#", "#...#", "#...#", "#...#"),
    "A": ("..#..", ".#.#.", "#...#", "#####", "#...#", "#...#", "#...#"),
    "R": ("####.", "#...#", "#...#", "####.", "#.#..", "#..#.", "#...#"),
    "C": (".####", "#....", "#....", "#....", "#....", "#....", ".####"),
    "H": ("#...#", "#...#", "#...#", "#####", "#...#", "#...#", "#...#"),
    "Y": ("#...#", ".#.#.", "..#..", "..#..", "..#..", "..#..", "..#.."),
}
CELL_WIDTH = 2
LETTER_GAP = 2
ROW_SCALE = 3


def neighbors(point, cells):
    x, y = point
    for candidate in (
        (x - 1, y - 1), (x, y - 1), (x + 1, y - 1),
        (x - 1, y), (x + 1, y),
        (x - 1, y + 1), (x, y + 1), (x + 1, y + 1),
    ):
        if candidate in cells:
            yield candidate


def trace_order(cells):
    start = min(cells, key=lambda point: (point[1], point[0]))
    visited = {start}
    route = [start]

    def walk(point):
        for adjacent in sorted(neighbors(point, cells), key=lambda p: (p[1], p[0])):
            if adjacent not in visited:
                visited.add(adjacent)
                route.append(adjacent)
                walk(adjacent)
                route.append(point)

    walk(start)
    return route


def rail_char(point, shown):
    adjacent = set(neighbors(point, shown))
    x, y = point
    horizontal = (x - 1, y) in adjacent or (x + 1, y) in adjacent
    vertical = (x, y - 1) in adjacent or (x, y + 1) in adjacent
    diagonal_up = (x - 1, y - 1) in adjacent or (x + 1, y + 1) in adjacent
    diagonal_down = (x + 1, y - 1) in adjacent or (x - 1, y + 1) in adjacent
    if horizontal and vertical:
        return "++"
    if horizontal:
        return "=="
    if vertical:
        return "||"
    if diagonal_up and diagonal_down:
        return "++"
    if diagonal_up:
        return "\\\\"
    if diagonal_down:
        return "//"
    return "oo"


def draw(glyphs, completed, current, current_letter, cursor, width, height):
    art_width = len(glyphs) * 5 * CELL_WIDTH + (len(glyphs) - 1) * LETTER_GAP * CELL_WIDTH
    left = max(0, (width - art_width) // 2)
    top = max(0, (height - 7 * ROW_SCALE) // 2)
    rows = [[" "] * width for _ in range(height)]
    for y in range(7):
        for row in range(top + y * ROW_SCALE, top + (y + 1) * ROW_SCALE):
            if row >= height:
                continue
            x = left
            for index, (cells, _) in enumerate(glyphs):
                shown = cells if index < completed else current if index == current_letter else set()
                for cell_x in range(5):
                    point = (cell_x, y)
                    if point in shown:
                        text = "<>" if index == current_letter and point == cursor else rail_char(point, shown)
                        for offset, symbol in enumerate(text):
                            if x + offset < width:
                                rows[row][x + offset] = symbol
                    x += CELL_WIDTH
                if index < len(glyphs) - 1:
                    x += LETTER_GAP * CELL_WIDTH
    return "\n".join("".join(row) for row in rows)


def emit(frame):
    data = frame.encode("utf-8")
    sys.stdout.buffer.write(struct.pack("<I", len(data)))
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cycles", type=int, default=0, help="stop after N complete drawings (0 loops forever)")
    args = parser.parse_args()
    text = sys.stdin.read().strip().upper() or "OMARCHY"
    if any(letter not in GLYPHS for letter in text):
        parser.error("input must contain only O, M, A, R, C, H, Y")
    width = int(os.environ["TTFX_CANVAS_WIDTH"])
    height = int(os.environ["TTFX_CANVAS_HEIGHT"])
    fps = int(os.environ.get("TTFX_FRAME_RATE", "60")) or 60
    glyphs = []
    for letter in text:
        cells = {(x, y) for y, row in enumerate(GLYPHS[letter]) for x, pixel in enumerate(row) if pixel == "#"}
        glyphs.append((cells, trace_order(cells)))
    cycles = 0
    while args.cycles == 0 or cycles < args.cycles:
        for index, (_, route) in enumerate(glyphs):
            shown = set()
            for point in route:
                shown.add(point)
                emit(draw(glyphs, index, shown, index, point, width, height))
            pause = draw(glyphs, index + 1, set(), index + 1, None, width, height)
            for _ in range(max(1, round(fps * 0.25))):
                emit(pause)
        final = draw(glyphs, len(glyphs), set(), len(glyphs), None, width, height)
        for _ in range(max(1, round(fps * 2))):
            emit(final)
        cycles += 1


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
